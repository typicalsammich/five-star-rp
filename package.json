{
  "name": "five-star-rp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build-sites.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node --check scripts/build.mjs && node --check public/site.js && node --check api/contact.js",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target es2022 --module nodenext data/business.mjs",
    "build:sites": "node scripts/build-sites.mjs",
    "build:static": "node scripts/build.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "esbuild": "^0.27.0",
    "sharp": "^0.34.5"
  }
}